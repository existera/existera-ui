{
  "name": "@existera/ui",
  "version": "1.0.2",
  "description": "Modern React UI Library",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:types": "tsc --noEmit",
    "check:package": "publint --strict",
    "check:exports": "attw --pack --profile esm-only --exclude-entrypoints ./style.css",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "check:components": "node --test scripts/check-*.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:forms": "tsc --ignoreConfig --noEmit --strict --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --skipLibCheck scripts/check-form-types.tsx",
    "check:button": "tsc --ignoreConfig --noEmit --strict --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --skipLibCheck scripts/check-button-types.tsx",
    "check:consumer": "node scripts/check-package.mjs",
    "check:production": "npm run lint && npm run check:types && npm run build && npm run check:components && npm run check:css && npm run check:forms && npm run check:button && npm run check:package && npm run check:exports && npm run check:consumer",
    "prepublishOnly": "npm run check:production"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3"
  }
}